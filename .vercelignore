# Only the Next.js in-browser ONNX detection app (pages/, components/,
# utils/, data/yolo_classes.ts, models/, public/) needs to be uploaded here
# - everything below either belongs to a different deployment target (the
# taco inference-server + training pipeline, deployed separately - see
# docs/system-architecture.md) or is a huge build/dataset artifact that
# Vercel never needs. Presence of this file makes Vercel CLI use *only*
# these rules instead of .gitignore, so the usual node_modules/.next/venv
# excludes are re-listed explicitly below rather than assumed.

# Python backend + its own venv - runs on taco, not Vercel.
inference-server/

# Training pipeline, its venv, and every dataset - never needed at runtime,
# and data/external_datasets + data/license_plates alone are 800MB+.
training/
data/external_datasets/
data/license_plates/
data/unlabeled/
convert_pt_to_onnx/
runs/
*.pt

# Docs - not needed to build/serve the app.
docs/

# Local build artifacts / dependency trees - Vercel installs deps and runs
# `next build` itself; public/runtime/ in particular is regenerated by
# next.config.js's CopyPlugin from node_modules + models/, not checked in.
node_modules/
.next/
public/runtime/
__pycache__/
*.mp4

# Ship only the default model (yolo12n.onnx - RES_TO_MODEL[0] in Yolo.tsx,
# also DEFAULT_MODEL in inference-server/main.py) to keep this deploy
# small. Deliberate tradeoff: the "Change Model" button will 404 for the
# other five model files on this specific deployment.
models/*
!models/yolo12n.onnx

# Local/dev-only files.
.git/
.vercel/
.env
.env.local
*.log
